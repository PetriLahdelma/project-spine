  "repoConventions": [
    {
      "id": "conv-73b7f1ee",
      "text": "Use the Next.js App Router (`app/`). Prefer server components by default; only opt into client components via `\"use client\"` when needed.",
      "source": {
        "kind": "inference",
        "pointer": "inferred:next/app-router"
      }
    },
    {
      "id": "conv-2deb53da",
      "text": "Style exclusively with Tailwind utility classes. Do not add inline `style` props or ad-hoc CSS unless the component is outside the design system.",
      "source": {
        "kind": "inference",
        "pointer": "inferred:tailwind"
      }
    },
    {
      "id": "conv-9eee0397",
      "text": "TypeScript strict mode is on. Never use `any`; prefer `unknown` + narrow at the boundary.",
